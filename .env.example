# EmailJS Configuration
# Create a free account at https://www.emailjs.com/
# 1. Create an Email Service (e.g., Gmail, Outlook) -> copy Service ID
# 2. Create an Email Template -> copy Template ID
#    Template variable names expected: {{from_name}}, {{from_email}}, {{message}}
# 3. Go to Account -> Public Key -> copy Public Key
# 4. (Optional) Create an Auto-Reply Email Template -> copy Template ID

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional Auto-Reply Template ID
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=
